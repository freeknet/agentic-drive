{
	"id": "/",
	"name": "Drive",
	"short_name": "Drive",
	"description": "Your midwestfreeks.org file storage: upload, organise, share and send files with Mail.",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"display_override": ["window-controls-overlay", "standalone"],
	"orientation": "any",
	"background_color": "#f8fafd",
	"theme_color": "#f8fafd",
	"categories": ["productivity", "utilities"],
	"lang": "en",
	"dir": "ltr",
	"launch_handler": { "client_mode": ["focus-existing", "auto"] },
	"icons": [
		{ "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
		{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
		{ "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
		{ "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
		{ "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
		{ "src": "/icons/badge-96.png", "sizes": "96x96", "type": "image/png", "purpose": "monochrome" }
	],
	"shortcuts": [
		{ "name": "Recent", "description": "Files you changed lately", "url": "/recent", "icons": [{ "src": "/icons/recent-96.png", "sizes": "96x96", "type": "image/png" }] },
		{ "name": "Starred", "description": "Your starred files", "url": "/starred", "icons": [{ "src": "/icons/starred-96.png", "sizes": "96x96", "type": "image/png" }] }
	],
	"share_target": {
		"action": "/share-target",
		"method": "POST",
		"enctype": "multipart/form-data",
		"params": {
			"title": "title",
			"text": "text",
			"files": [{ "name": "files", "accept": ["*/*"] }]
		}
	},
	"file_handlers": [
		{
			"action": "/",
			"accept": {
				"application/pdf": [".pdf"],
				"image/*": [".png", ".jpg", ".jpeg", ".gif", ".webp", ".heic", ".svg"],
				"video/*": [".mp4", ".mov", ".webm", ".mkv"],
				"audio/*": [".mp3", ".m4a", ".wav", ".flac", ".ogg"],
				"text/*": [".txt", ".md", ".csv"],
				"application/zip": [".zip"],
				"application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"],
				"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"],
				"application/vnd.openxmlformats-officedocument.presentationml.presentation": [".pptx"]
			},
			"launch_type": "single-client"
		}
	]
}
