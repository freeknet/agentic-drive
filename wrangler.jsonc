{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "agentic-drive",
	"compatibility_date": "2026-11-01",
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		// Cloudflare Access: team domain and the audience tag of the "agentic-drive"
		// Access app (not secrets). Access's team session means a sign-in to Mail also
		// covers Drive, with no second login. The Worker fails closed without them.
		"TEAM_DOMAIN": "https://wsllc.cloudflareaccess.com",
		"POLICY_AUD": "5eb493f6652938813d9b24aa646f397c0c78267ff150bf15f2785023bef53220",
		// Public origin used to build share links.
		"PUBLIC_URL": "https://drive.midwestfreeks.org",
		// The agentic-inbox app, for the Mail | Drive switcher (optional).
		"MAIL_URL": "https://mail.midwestfreeks.org"
	},
	"routes": [
		{ "pattern": "drive.midwestfreeks.org", "custom_domain": true }
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "agentic-drive",
			"preview_bucket_name": "agentic-drive"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "DRIVE",
				"class_name": "DriveDO"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"DriveDO"
			]
		}
	]
}
